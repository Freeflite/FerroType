// Colors shared by every view, after Ferrotop's. Exported to Rust (via main.slint) so `dark` can be
// set directly and the native title bar can use the same colors.
export global Theme {
    in-out property <bool> dark;
    out property <color> background: dark ? #14161b : #ffffff;
    out property <color> panel: dark ? #1b1e25 : #f3f4f6;
    out property <color> border: dark ? #2c313c : #d8dbe0;
    out property <color> text: dark ? #e4e6eb : #1c2026;
    out property <color> muted: dark ? #8a919e : #5c6470;
    out property <color> accent: dark ? #e8743b : #c2501b;
    out property <color> hover: dark ? #ffffff0c : #0000000a;
    out property <color> pinned: dark ? #d9b84a1a : #fff6d6;
    out property <color> error: dark ? #ff7b72 : #b42318;
}

// What the icon button under the pointer does, shown at the bottom of the history panel.
export global Hint {
    in-out property <string> text;
}

// 16 x 16 outline icons, as path commands.
export global Icons {
    out property <string> pin: "M 9.5 1.5 L 14.5 6.5 L 12.6 7.1 L 10.2 9.5 L 10.5 12.6 L 3.4 5.5 L 6.5 5.8 L 8.9 3.4 Z M 6.6 9.4 L 1.8 14.2";
    out property <string> play: "M 4.5 2.5 L 13 8 L 4.5 13.5 Z";
    out property <string> copy: "M 5.5 5.5 L 13.5 5.5 L 13.5 14.5 L 5.5 14.5 Z M 10.5 5.5 L 10.5 2 L 2.5 2 L 2.5 11 L 5.5 11";
    out property <string> trash: "M 2 4 L 14 4 M 6 4 L 6 2 L 10 2 L 10 4 M 3.8 4 L 4.6 14.5 L 11.4 14.5 L 12.2 4 M 6.8 7 L 6.8 12 M 9.2 7 L 9.2 12";
}
